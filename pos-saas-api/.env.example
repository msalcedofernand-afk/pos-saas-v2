NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy compatibility only; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-key
STORE_DEVICE_SETUP_KEY=change-this-device-setup-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
# Use "none" only when the web and API are truly cross-site; it requires Secure cookies.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
